# Fallback for shared hosting where the document root cannot point to /public.
# Every request is served from /public, so files like .env are never exposed.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force 301 Redirect from www to non-www (Canonical Domain)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

